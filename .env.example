# TRACE Environment Configuration
# Add your Gemini API key from https://aistudio.google.com/
# If left empty, TRACE automatically runs in deterministic fallback mode!
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
PORT=3000

# Node Environment ('development' | 'production')
NODE_ENV=development

# Administrative Endpoint Security Key
# Protects /api/scamchain/reset and /api/scamchain/seed endpoints
# SECURITY REQUIREMENT:
# In development: defaults to 'trace-dev-admin' if unset.
# In production: MUST be a strong, randomly generated secret of at least 16 characters.
# The server fails safely at startup if an insecure or default key is detected in production.
TRACE_ADMIN_KEY=trace-dev-admin

# Configurable CORS Allowed Origins (comma-separated, e.g. http://localhost:3000,https://my-domain.com)
# Defaults to localhost and browser extension origins if not set
ALLOWED_ORIGINS=


